<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/SeaBlue" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_fill" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/input_stroke" />
            <padding android:left="18dp" android:top="14dp" android:right="18dp" android:bottom="14dp" />
        </shape>
    </item>
</selector>