<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".chatbot.ChatbotActivity">

    <View
        android:id="@+id/header_principal"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/header_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imgback"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/circle_button"
        android:contentDescription="@string/atras"
        android:elevation="4dp"
        android:scaleType="center"
        android:src="@drawable/tabler_arrow_left"
        app:layout_constraintBottom_toBottomOf="@id/header_principal"
        app:layout_constraintLeft_toLeftOf="@id/header_principal"
        app:layout_constraintTop_toTopOf="@id/header_principal"
        app:tint="@color/DarkBlue" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/header_principal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/header_principal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.05"
            android:text="@string/healthy_bot"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_light"
            android:text="@string/healthy_bot_subtitle"
            android:textColor="@color/SeaBlue"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/boxredact"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_principal">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/circle_soft"
            android:contentDescription="@string/healthy_bot"
            android:padding="22dp"
            android:src="@drawable/chatboticon"
            android:tint="@color/DarkBlue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/chatbot_empty_message"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/boxredact"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_principal" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/boxredact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/input_bar_bg"
        android:paddingVertical="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageButton
            android:id="@+id/imgbtnsend"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_send"
            android:contentDescription="@string/btn_send"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/edittextmessage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/edittextdesign"
            android:fontFamily="@font/poppins_light"
            android:hint="@string/chatbot_placeholder"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="3"
            android:paddingHorizontal="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/imgbtnsend"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>