<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".activityphysique.PhysiqueActivity">

    <View
        android:id="@+id/principal"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/header_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/actividad_fisica"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="@id/principal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/principal" />

    <ImageButton
        android:id="@+id/backbutton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/circle_button"
        android:contentDescription="@string/back"
        android:elevation="4dp"
        android:pointerIcon="hand"
        android:scaleType="center"
        android:src="@drawable/backleft"
        app:layout_constraintBottom_toBottomOf="@id/principal"
        app:layout_constraintLeft_toLeftOf="@id/principal"
        app:layout_constraintTop_toTopOf="@id/principal"
        app:tint="@color/DarkBlue"
        tools:ignore="TouchTargetSizeCheck" />

    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/principal">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/boxone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardviewone"
                android:layout_width="0dp"
                android:layout_height="180dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/cardviewtwo"
                app:layout_constraintTop_toTopOf="@id/boxone"
                android:layout_marginEnd="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/cardcalis"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/calis" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/scrim_bottom"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingVertical="10dp"
                        android:text="@string/calistenico"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="normal" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardviewtwo"
                android:layout_width="0dp"
                android:layout_height="180dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:layout_constraintLeft_toRightOf="@id/cardviewone"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/boxone"
                android:layout_marginStart="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/gym"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/gym" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/scrim_bottom"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingVertical="10dp"
                        android:text="@string/pesas"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="normal" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardviewtree"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/cardviewfour"
                app:layout_constraintTop_toBottomOf="@id/cardviewone"
                android:layout_marginEnd="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/aerobico"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/aerobico" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/scrim_bottom"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingVertical="10dp"
                        android:text="@string/aerobico"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="normal" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardviewfour"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:layout_constraintLeft_toRightOf="@id/cardviewtree"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardviewtwo"
                android:layout_marginStart="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageButton
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/gym"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/dietasana" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@drawable/scrim_bottom"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:paddingVertical="10dp"
                        android:text="Dieta"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="normal" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/primercuadro"
                android:layout_width="86dp"
                android:layout_height="86dp"
                app:layout_constraintBottom_toBottomOf="@id/cardviewone"
                app:layout_constraintLeft_toLeftOf="@id/cardviewone"
                app:layout_constraintRight_toRightOf="@id/cardviewone"
                app:layout_constraintTop_toTopOf="@id/cardviewone"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/touchscreen" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/segundocuadro"
                android:layout_width="86dp"
                android:layout_height="86dp"
                app:layout_constraintBottom_toBottomOf="@id/cardviewtwo"
                app:layout_constraintLeft_toLeftOf="@id/cardviewtwo"
                app:layout_constraintRight_toRightOf="@id/cardviewtwo"
                app:layout_constraintTop_toTopOf="@id/cardviewtwo"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/touchscreen" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/tercercuadro"
                android:layout_width="86dp"
                android:layout_height="86dp"
                app:layout_constraintBottom_toBottomOf="@id/cardviewtree"
                app:layout_constraintLeft_toLeftOf="@id/cardviewtree"
                app:layout_constraintRight_toRightOf="@id/cardviewtree"
                app:layout_constraintTop_toTopOf="@id/cardviewtree"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/touchscreen" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/utlimocuadro"
                android:layout_width="86dp"
                android:layout_height="86dp"
                app:layout_constraintBottom_toBottomOf="@id/cardviewfour"
                app:layout_constraintLeft_toLeftOf="@id/cardviewfour"
                app:layout_constraintRight_toRightOf="@id/cardviewfour"
                app:layout_constraintTop_toTopOf="@id/cardviewfour"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/touchscreen" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/border_style"
                android:elevation="4dp"
                android:letterSpacing="0.03"
                android:lineSpacingExtra="4sp"
                android:padding="18dp"
                android:text="@string/definicion_af"
                android:textAlignment="textStart"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="normal"
                android:fontFamily="@font/poppins_light"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardviewtree" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>