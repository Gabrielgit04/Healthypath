<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/principal"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/header_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:padding="10sp"
            android:text="Dieta Saludable"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="@id/principal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/firstbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_light"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/principal">

            <ImageView
                android:id="@+id/imgdieta"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/dietlist"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@id/firstbox" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgdieta">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pressbtn"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:paddingVertical="12dp"
                    android:text="Dieta segun su objetivo"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Aumento de masa muscular"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="16sp"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/newcolorbg"
                    android:padding="12dp"
                    android:text="@string/ingestaProteica"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="normal"
                            android:fontFamily="@font/poppins_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Disminuir grasa"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="16sp"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/newcolorbg"
                    android:padding="12dp"
                    android:text="@string/disminuir"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="normal"
                            android:fontFamily="@font/poppins_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Alimentos recomendados"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="16sp"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/newcolorbg"
                    android:padding="12dp"
                    android:text="@string/alimentos"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="normal"
                            android:fontFamily="@font/poppins_light" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Nota: Esto sirve para cualquier disciplina, no precisamente para el gym."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_light"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/pressbtn"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:paddingVertical="12dp"
                    android:text="Calcular tu requerimiento proteico"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/newcolorbg"
                    android:padding="12dp"
                    android:text="Para calcular el requerimiento proteico de una persona para aumentar su masa muscular, se utiliza la formula de 2gr de proteina*kg de peso."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="normal"
                            android:fontFamily="@font/poppins_light" />

                <LinearLayout
                    android:id="@+id/requerimientobox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/pesoxg"
                        style="@style/Widget.Healthypath.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/ingrese_su_peso"
                        android:inputType="numberDecimal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/calcularpxg"
                        style="@style/Widget.Healthypath.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/calcularL" />

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>